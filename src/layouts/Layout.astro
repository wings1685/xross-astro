---
import { StoresWatcher } from "@/components/shared";
import "@/_global/styles/global.sass";

type Props = {
	title: string;
};
const { title }: Props = Astro.props;
---
<!doctype html>
<html lang="ja">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={ Astro.generator } />
	<title>{ title }</title>
</head>
<body>
	<main>
		<slot />
	</main>
	<StoresWatcher />
</body>
</html>
